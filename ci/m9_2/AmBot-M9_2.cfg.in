# Generated template for AmBot M9.2.
# Replace HOST_IP with the host reachable from the Amiga guest.
OWNER=Tester
HOOK_DIR=REXX:AmBot/M9_2

[NETWORK alpha]
HOST=HOST_IP
PORT=17667
